{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "variables.schema.json",
  "title": "HOPA 程序变量",
  "x-rule-suffix": "VARIABLES",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["变量ID", "变量名", "类型", "默认值", "写入条件", "持久性", "约束"],
    "additionalProperties": false,
    "properties": {
      "变量ID": { "type": "string", "pattern": "^VAR-G\\d{2}-\\d{3}$" },
      "变量名": { "type": "string" },
      "类型": { "type": "string" },
      "默认值": { "type": ["string", "number", "boolean", "null"] },
      "写入条件": { "type": "string" },
      "持久性": { "type": "string" },
      "约束": { "type": "string" }
    }
  }
}
