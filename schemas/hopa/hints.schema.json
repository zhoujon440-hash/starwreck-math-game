{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hints.schema.json",
  "title": "HOPA 三级提示",
  "x-rule-suffix": "HINTS",
  "type": "array",
  "minItems": 3,
  "items": {
    "type": "object",
    "required": ["提示ID", "场景ID", "机关/任务", "提示等级", "提示文本", "触发条件", "效果"],
    "additionalProperties": false,
    "properties": {
      "提示ID": { "type": "string", "pattern": "^HINT-G\\d{2}-\\d{3}(?:-[123])?$" },
      "场景ID": { "type": "string", "pattern": "^SCN-G\\d{2}-\\d{2}[A-Z]?$" },
      "机关/任务": { "type": "string" },
      "提示等级": { "type": "string" },
      "提示文本": { "type": "string" },
      "触发条件": { "type": "string" },
      "效果": { "type": "string" }
    }
  }
}
