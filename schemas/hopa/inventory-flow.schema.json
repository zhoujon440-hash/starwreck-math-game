{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory-flow.schema.json",
  "title": "HOPA 背包道具流转",
  "x-rule-suffix": "INVENTORY",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["道具ID", "名称", "类别", "取得位置", "使用热点", "用途", "消耗规则", "归还/归档", "备注"],
    "additionalProperties": false,
    "properties": {
      "道具ID": { "type": "string", "pattern": "^ITM-G\\d{2}-\\d{3}$" },
      "名称": { "type": "string" },
      "类别": { "type": "string" },
      "取得位置": { "type": "string" },
      "使用热点": { "type": "string" },
      "用途": { "type": "string" },
      "消耗规则": { "type": "string" },
      "归还/归档": { "type": "string" },
      "备注": { "type": "string" }
    }
  }
}
