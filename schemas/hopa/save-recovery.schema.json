{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "save-recovery.schema.json",
  "title": "HOPA 存档与恢复",
  "x-rule-suffix": "SAVE-RECOVERY",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["存档ID", "场景ID", "触发条件", "保存内容", "恢复位置"],
    "additionalProperties": false,
    "properties": {
      "存档ID": { "type": "string", "pattern": "^(?:AUTO|MAN)-G\\d{2}-\\d{3}[A-Z]?$" },
      "场景ID": { "type": "string", "pattern": "^(?:SCN-G\\d{2}-\\d{2}[A-Z]?|任意安全场景)$" },
      "触发条件": { "type": "string" },
      "类型": { "type": "string" },
      "保存内容": { "type": "string" },
      "恢复位置": { "type": "string" }
    }
  }
}
