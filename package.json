{
  "name": "starwreck-math-game",
  "private": true,
  "version": "0.2.2",
  "demoVersion": "G01-DEMO-0.1.0",
  "g02SliceVersion": "G02-SLICE-0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "build:scn01-art": "python scripts/build_g01_scn01_runtime_art.py",
    "build:g01-pr-a-art": "python scripts/build_g01_pr_a_runtime_art.py",
    "build:g01-pr-b-art": "python scripts/build_g01_pr_b_runtime_art.py",
    "build:g01-pr-c-art": "python scripts/build_g01_pr_c_runtime_art.py",
    "build:g02-slice-art": "python scripts/build_g02_slice_runtime_art.py",
    "validate:sources": "node scripts/validate-source-import.mjs",
    "validate:baseline": "node scripts/validate-baseline.mjs",
    "validate:characters": "node scripts/validate-character-assets.mjs",
    "validate:character-story": "node scripts/validate-character-story.mjs",
    "validate:g01-pr-a": "node scripts/validate-g01-pr-a.mjs",
    "validate:g01-pr-b": "node scripts/validate-g01-pr-b.mjs",
    "validate:g01-pr-c": "node scripts/validate-g01-demo.mjs",
    "validate:g01-demo": "node scripts/validate-g01-demo.mjs",
    "validate:g02-slice-01": "node scripts/validate-g02-slice-01.mjs",
    "test:baseline": "node --test tests/baseline/*.test.mjs",
    "test:characters": "node --test tests/characters/*.test.mjs",
    "test:character-story": "vitest run tests/character-story/character-data.test.ts tests/character-story/dialogue.test.ts && node --test tests/character-story/character-story-negative.test.mjs",
    "test:g01-pr-a": "vitest run tests/g01-pr-a/runtime.test.ts && node --test tests/g01-pr-a/g01-pr-a-negative.test.mjs",
    "test:g01-pr-b": "vitest run tests/g01-pr-b/runtime.test.ts && node --test tests/g01-pr-b/g01-pr-b-negative.test.mjs",
    "test:g01-pr-c": "vitest run tests/g01-demo/runtime.test.ts && node --test tests/g01-demo/g01-demo-negative.test.mjs",
    "test:g01-demo": "vitest run tests/g01-demo/runtime.test.ts && node --test tests/g01-demo/g01-demo-negative.test.mjs",
    "test:g02-slice-01": "vitest run tests/g02-slice-01/runtime.test.ts && node --test tests/g02-slice-01/g02-slice-negative.test.mjs",
    "package:g01-demo": "node scripts/package-g01-demo.mjs",
    "package:g02-slice-01": "node scripts/package-g02-slice-01.mjs",
    "check": "npm run validate:sources && npm run validate:baseline && npm run test:baseline && npm run test && npm run build"
  },
  "dependencies": {
    "vite-plugin-pwa": "^1.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
