[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/TitleScreen.gd" id="1_title"]
[ext_resource type="Script" path="res://scripts/core/SceneDirector.gd" id="2_director"]
[ext_resource type="Texture2D" path="res://assets/inherited/g01-cockpit.png" id="3_backdrop"]

[sub_resource type="StyleBoxFlat" id="Style_action"]
bg_color = Color(0.025, 0.08, 0.105, 0.94)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.2, 0.66, 0.72, 0.75)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
shadow_color = Color(0, 0, 0, 0.55)
shadow_size = 8

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

[node name="SceneBackdrop" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("3_backdrop")
expand_mode = 1
stretch_mode = 6
mouse_filter = 2

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.004, 0.011, 0.024, 0.72)
mouse_filter = 2

[node name="Vignette" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.15, 0.24, 0.22)
mouse_filter = 2

[node name="AmbientPulse" type="Polygon2D" parent="."]
polygon = PackedVector2Array(0, 0, 1920, 0, 1920, 118, 0, 118)
color = Color(0.48, 0.035, 0.025, 0.24)

[node name="TitleLayout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -420.0
offset_top = -250.0
offset_right = 420.0
offset_bottom = 250.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 24

[node name="Eyebrow" type="Label" parent="TitleLayout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.43, 0.86, 0.92, 1)
theme_override_font_sizes/font_size = 24
text = "STARWRECK  /  PROLOGUE INVESTIGATION"
horizontal_alignment = 1

[node name="Title" type="Label" parent="TitleLayout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.96, 1, 1)
theme_override_font_sizes/font_size = 64
text = "星骸拾荒者：十二星门"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="TitleLayout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.63, 0.7, 0.76, 1)
theme_override_font_sizes/font_size = 28
text = "SCN-G01-00 · 拾光号熄灯"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="TitleLayout"]
custom_minimum_size = Vector2(0, 28)
layout_mode = 2

[node name="NewGame" type="Button" parent="TitleLayout"]
custom_minimum_size = Vector2(0, 76)
layout_mode = 2
theme_override_font_sizes/font_size = 28
theme_override_styles/normal = SubResource("Style_action")
text = "新游戏"

[node name="Continue" type="Button" parent="TitleLayout"]
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
theme_override_font_sizes/font_size = 24
theme_override_styles/normal = SubResource("Style_action")
text = "继续"

[node name="SaveNotice" type="Label" parent="TitleLayout"]
visible = false
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.55, 0.34, 1)
theme_override_font_sizes/font_size = 17
text = "调查记录已损坏，无法继续。请选择“新游戏”重建本关记录。"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="Footer" type="Label" parent="."]
layout_mode = 1
anchors_preset = 12
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 260.0
offset_top = -86.0
offset_right = -260.0
offset_bottom = -34.0
grow_horizontal = 2
grow_vertical = 0
theme_override_colors/font_color = Color(0.48, 0.58, 0.61, 1)
theme_override_font_sizes/font_size = 17
text = "WINDOWS NATIVE · SCN-G01-00 · 现场调查 / 线索推理 / 实体维修"
horizontal_alignment = 1

[node name="OverwriteConfirm" type="ConfirmationDialog" parent="."]
title = "覆盖现有调查记录？"
dialog_text = "开始新游戏会覆盖当前 SCN-G01-00 存档。"
ok_button_text = "确认开始"
cancel_button_text = "保留存档"

[node name="SceneDirector" type="Node" parent="."]
script = ExtResource("2_director")

[connection signal="pressed" from="TitleLayout/NewGame" to="." method="_on_new_game_pressed"]
[connection signal="pressed" from="TitleLayout/Continue" to="." method="_on_continue_pressed"]
[connection signal="confirmed" from="OverwriteConfirm" to="." method="_on_overwrite_confirmed"]
[connection signal="new_game_requested" from="." to="SceneDirector" method="start_new_game"]
[connection signal="continue_requested" from="." to="SceneDirector" method="resume_game"]

